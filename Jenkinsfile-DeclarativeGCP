pipeline {
    agent any

    stages {
        stage('checkout source code') {
            steps {
                git branch: 'main', url: 'https://gitlab.com/deepakgcp25/easyfly'
            }
        }
        stage('build'){
             steps{
                 withMaven(maven: 'maven3.9.9') {
                 sh 'mvn clean package'
                }      
             }
        }
        stage('static code analsis'){
             steps{
                 withMaven(maven: 'maven3.9.9') {
                 sh 'mvn sonar:sonar  -Dsonar.host.url=http://34.173.22.71:9000/ -Dsonar.login=$SONAR_TOKEN'
                }      
             }
        }
      stage('test'){
             steps{
                 withMaven(maven: 'maven3.9.9') {
                 sh 'mvn test'
                }      
             }
        }
      stage('public url'){
             steps{
                 withMaven(maven: 'maven3.9.9') {
                 echo 'http://34.173.22.71:8081/'
                }      
             }
        }
        stage('Run Application'){
             steps{
                 withMaven(maven: 'maven3.9.9') {
                 sh 'mvn spring-boot:run -Dspring-boot.run.profiles=dev'
                }      
             }
        }

    }
}