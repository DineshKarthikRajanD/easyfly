pipeline {
    agent any
    stages {
        stage('run docker image') {
            steps {
                script{
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                    sh 'docker run -d -p 8081:8081 dadaramjadhav/easyfly:dev'
                }
                }
            }
        }
        stage('publish url'){
            steps{ 
                echo 'http://<public-ip>:8081/'   
            }
        }
    }
}